# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=nguyenthituyetmay
POSTGRES_PASSWORD=iloveyou044
POSTGRES_DB=vietsuccess
DATABASE_URL=postgresql://nguyenthituyetmay:iloveyou044@localhost:5433/vietsuccess

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9100
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_VIDEOS=vietsuccess-videos
MINIO_BUCKET_CLIPS=vietsuccess-clips
MINIO_SECURE=false

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Backend: auto | mlx | faster-whisper
WHISPER_BACKEND=auto
# large-v3-turbo = best balance speed/quality on Apple Silicon
WHISPER_MODEL=large-v3-turbo
# Language hint — skips auto-detection
WHISPER_LANGUAGE=vi
# faster-whisper fallback settings
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# Speaker diarization
PYANNOTE_AUTH_TOKEN=
PYANNOTE_USE_TITLE_SPEAKER_HINT=false

# Embedding backend: openai | bge-m3
EMBEDDING_BACKEND=openai

# ── YouTube crawl (yt-dlp) ────────────────────────────────────────────────────
YOUTUBE_FORMAT=bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best
YOUTUBE_DOWNLOAD_DIR=/tmp/vietsuccess_youtube
YOUTUBE_FETCH_THUMBNAIL=true

# Anti-bot throttling (tránh bị YouTube nghi là bot khi dùng yt-dlp)
YOUTUBE_SLEEP_INTERVAL_S=1.0        # yt-dlp nghỉ tối thiểu trước mỗi lần tải
YOUTUBE_MAX_SLEEP_INTERVAL_S=5.0    # nghỉ ngẫu nhiên tối đa trước mỗi lần tải
YOUTUBE_SLEEP_REQUESTS_S=0.75       # nghỉ giữa các request lấy metadata
CRAWL_REST_MIN_S=20.0              # nghỉ tối thiểu giữa 2 video trong playlist
CRAWL_REST_MAX_S=45.0              # nghỉ tối đa giữa 2 video trong playlist

# YouTube caption as PRIMARY transcript (Whisper STT is fallback) — saves API tokens
CAPTION_FIRST=true
CAPTION_LANGUAGES=vi,en
CAPTION_SEGMENT_TARGET_S=10.0

# ── Phase 4 — summarization ───────────────────────────────────────────────────
SUMMARY_ENABLED=true
SUMMARY_MODEL=gpt-4o-mini
SUMMARY_MAX_INPUT_CHARS=48000

# Audio processing
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Chunking
ATOMIC_MAX_DURATION_MS=20000
ATOMIC_MIN_DURATION_MS=2000
SEMANTIC_TARGET_MIN_MS=45000
SEMANTIC_TARGET_MAX_MS=90000
SEMANTIC_OVERLAP_MS=7500
SPEAKER_MERGE_GAP_MS=1500

# Quality gate
QUALITY_MIN_CONFIDENCE=0.65
QUALITY_MIN_DURATION_MS=3000
QUALITY_MAX_DURATION_MS=120000
QUALITY_MAX_NULL_SPEAKER_RATIO=0.30
QUALITY_MAX_LOW_QUALITY_RATIO=0.08

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
