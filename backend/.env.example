# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=nguyenthituyetmay
POSTGRES_PASSWORD=iloveyou044
POSTGRES_DB=vietsuccess
DATABASE_URL=postgresql://nguyenthituyetmay:iloveyou044@localhost:5433/vietsuccess

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9100
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_VIDEOS=vietsuccess-videos
MINIO_BUCKET_CLIPS=vietsuccess-clips
MINIO_SECURE=false

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Backend: auto | mlx | faster-whisper
WHISPER_BACKEND=auto
# large-v3-turbo = best balance speed/quality on Apple Silicon
WHISPER_MODEL=large-v3-turbo
# Language hint — skips auto-detection
WHISPER_LANGUAGE=vi
# faster-whisper fallback settings
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# Speaker diarization
PYANNOTE_AUTH_TOKEN=
PYANNOTE_USE_TITLE_SPEAKER_HINT=false

# Embedding backend: openai | bge-m3
EMBEDDING_BACKEND=openai

# Audio processing
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Chunking
ATOMIC_MAX_DURATION_MS=20000
ATOMIC_MIN_DURATION_MS=2000
SEMANTIC_TARGET_MIN_MS=45000
SEMANTIC_TARGET_MAX_MS=90000
SEMANTIC_OVERLAP_MS=7500
SPEAKER_MERGE_GAP_MS=1500

# Quality gate
QUALITY_MIN_CONFIDENCE=0.65
QUALITY_MIN_DURATION_MS=3000
QUALITY_MAX_DURATION_MS=120000
QUALITY_MAX_NULL_SPEAKER_RATIO=0.30
QUALITY_MAX_LOW_QUALITY_RATIO=0.08

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
